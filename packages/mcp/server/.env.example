NODE_ENV=development
LOG_LEVEL=info
CONFIG_PATH=./config.yaml
OLLAMA_URL=http://localhost:11434
QDRANT_URL=http://localhost:6333

# Optional Qdrant auth (forwarded to @june/mcp-ingest)
# QDRANT_API_KEY=

# Models required by the @june/mcp-ingest pipeline (search + ingest tools).
# OLLAMA_EMBED_MODEL must match the model used when documents were ingested,
# or query and document vectors won't line up.
OLLAMA_EMBED_MODEL=snowflake-arctic-embed2
OLLAMA_CLASSIFIER_MODEL=qwen2.5:7b
OLLAMA_SUMMARIZER_MODEL=qwen2.5:7b

# Path to @june/mcp-ingest's config.yaml. Optional — when unset, ingest falls
# back to its own discovery chain (./config.yaml, ~/.config/june, defaults).
# INGEST_CONFIG_PATH=../ingest/config.yaml
