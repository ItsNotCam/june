qdrant_storage/
fixtures/
# …but the FROZEN canonical fixtures (Phase 3) are committed, immutable test
# sets — re-include that one location (its `.lock` proves it never drifts).
!packages/mcp/bench/fixtures/
!packages/mcp/bench/fixtures/**
# …and the committed judge test fixtures (grounding cases + the Phase-5 calibration
# gold set + recorded verdicts) — test data, tracked despite the broad `fixtures/` rule.
!packages/mcp/bench/__test__/judge/fixtures/
!packages/mcp/bench/__test__/judge/fixtures/**
# …and the committed Phase-7 hermetic e2e fixtures (tiny frozen corpus + recorded
# verdicts the e2e replays) — test data, tracked despite the broad `fixtures/` rule.
!packages/mcp/bench/__test__/e2e/fixtures/
!packages/mcp/bench/__test__/e2e/fixtures/**

# bench local state — runs, june scratch SQLite + Qdrant config, and the
# LLM response cache all live under packages/mcp/bench/state/. The dir
# itself (and the cache/ subdir) are tracked via .gitkeep so the layout
# survives a fresh clone; the contents are operator-local and gitignored.
packages/mcp/bench/state/runs/
packages/mcp/bench/state/scratch/
packages/mcp/bench/state/cache/llm/
!packages/mcp/bench/state/.gitkeep
!packages/mcp/bench/state/cache/.gitkeep
packages/mcp/bench/state/fixtures/
packages/mcp/bench/state/scaffold/
# Phase 4 holdout build scratch — the raw llms-full.txt source (3MB+), the split
# corpus, and the pre-freeze fixture. The FROZEN holdout lives under fixtures/.
packages/mcp/bench/state/holdout-src/
packages/mcp/bench/state/holdout-split/
packages/mcp/bench/state/holdout-fixture/
# Phase 5 judge-calibration build scratch (gold-merge, emitted tasks, agent verdicts).
# The COMMITTED gold + recorded verdicts live under __test__/judge/fixtures/.
packages/mcp/bench/state/calibration-build/

# Claude
.intermediary/
.claude/worktrees
.claude/plans/*
!.claude/plans/*.md
# Vault notes — scratch, research, engineering log, and canvas files live in
# the Obsidian vault and are NOT committed to the repo.
.claude/notes/

# Config
.env
.env.*
**/.env.*
config.yaml
config.yml
# …but the package eval/pipeline configs ARE versioned for reproducibility —
# they hold no secrets/local paths (OLLAMA_URL etc. live in .env).
!packages/mcp/bench/config.yaml
!packages/mcp/ingest/config.yaml
!packages/mcp/server/config.yaml

# bench state — ad-hoc run logs, watcher/driver shell scripts, .out files,
# per-run judge outputs, and any backup files produced during experiments.
packages/mcp/bench/state/*.log
packages/mcp/bench/state/*.sh
packages/mcp/bench/state/*.out
packages/mcp/bench/state/judge/
*-bak
*.bak